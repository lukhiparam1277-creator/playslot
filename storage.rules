rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Anyone can read public images
      allow read: if true;
      // Authenticated users can upload assets (images, receipts, logos) up to 5MB
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
